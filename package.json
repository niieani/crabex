{
  "name": "agent-context-trimmer",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev:proxy": "bun packages/proxy/src/cli.ts proxy",
    "dev:ui": "vp -C packages/ui dev",
    "build": "vp run -r build",
    "test": "bunx --bun vp test"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vite-plus": "0.2.9"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  },
  "patchedDependencies": {
    "@pierre/diffs@1.3.5": "patches/@pierre%2Fdiffs@1.3.5.patch"
  }
}
